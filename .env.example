# Sao chép thành .env.local (không commit) rồi điền giá trị thật.
# Bỏ trống DATABASE_URL → dùng PGlite trong .data/pglite (không cần cài Postgres).
# Đặt DATABASE_URL ở .env.local thì cả `npm run dev` cũng ghi vào CSDL đó.

# --- CSDL: Aiven PostgreSQL (Console → Service → Connection information → Service URI) ---
# DATABASE_URL=postgres://avnadmin:<mật khẩu>@<host>.aivencloud.com:<port>/defaultdb?sslmode=require
# Chứng chỉ CA của Aiven (tải "CA certificate"), dán nội dung PEM, xuống dòng viết \n — tuỳ chọn nhưng nên có
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Số kết nối tối đa mỗi instance (gói free Aiven giới hạn số kết nối)
# DATABASE_POOL_MAX=3

# --- Đăng nhập (better-auth) ---
# Bắt buộc ở production: chuỗi ngẫu nhiên ≥ 32 ký tự, vd `openssl rand -base64 32`
# BETTER_AUTH_SECRET=
# URL gốc của web, vd https://toeiclab.vercel.app (dev: http://localhost:3000)
# BETTER_AUTH_URL=http://localhost:3000

# --- Media: mặc định /media đọc từ thư mục Data/ trên máy ---
# Backblaze B2 bucket Private (đang dùng): /media/... chuyển hướng 302 tới B2 kèm giấy phép tải 7 ngày.
# Trên Vercel đặt MEDIA_SOURCE=b2 và B2_* (nên dùng key Read Only của bucket). Ở máy không đặt MEDIA_SOURCE → đọc Data/.
# MEDIA_SOURCE=b2
# B2_KEY_ID=
# B2_APP_KEY=
# B2_BUCKET=
# `npm run media:upload` cần key có quyền ghi (Read and Write) — chỉ để trong .env.local trên máy.

# Bucket Public / CDN (không dùng giấy phép): đặt trước khi build vì biến NEXT_PUBLIC_ được gắn vào mã lúc build
# NEXT_PUBLIC_MEDIA_BASE=https://f005.backblazeb2.com/file/<bucket>
